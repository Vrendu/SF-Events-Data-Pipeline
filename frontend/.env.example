# Copy to .env in this folder (see README). Values mirror backend/.env:
#
#   VITE_READ_API_KEY       → same as READ_API_KEY
#   VITE_MAPBOX_ACCESS_TOKEN → same as MAPBOX_API_KEY (public Mapbox token)

# Local dev: Vite proxies /api → localhost:8000
VITE_API_BASE_URL=/api

# Render (set on frontend service, then rebuild):
# VITE_API_BASE_URL=https://your-backend.onrender.com
# VITE_READ_API_KEY=<same as backend READ_API_KEY>

VITE_READ_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
